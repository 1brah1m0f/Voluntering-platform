# Public browser configuration. Use a publishable key or the legacy anon key.
# Production builds require both values unless demo mode is explicitly enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Explicit demo builds only. Development without credentials uses demo mode by default.
# Demo data/accounts stay in the browser; never enter real credentials into a demo.
VITE_ENABLE_DEMO=false

# Server-side only; never put service-role, Gemini or Resend keys in VITE_* variables.
# Used by jobs/notify.mjs and Supabase Custom SMTP configuration.
RESEND_API_KEY=
