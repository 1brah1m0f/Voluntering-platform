# Supabase project settings (Project Settings → API).
# Leave empty to use the local mock handler (submissions go to localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps JavaScript API browser key for the map page (/app/map).
# Restrict it in Google Cloud: Application restrictions → Websites → your domains;
# API restrictions → Maps JavaScript API. Without it the page shows a country list.
VITE_GOOGLE_MAPS_API_KEY=

# Server-side only. Never prefix this with VITE_ or expose it in the browser.
# Used by jobs/notify.mjs and Supabase Custom SMTP configuration.
RESEND_API_KEY=
