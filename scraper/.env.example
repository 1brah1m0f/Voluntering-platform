# Supabase Configuration (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Gemini is OFF by default. Only --use-ai enables it.
# Leave empty for token-free, rule-based extraction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Selection uses CLI flags, not environment defaults:
# python3 scrape.py --scope local --source all --dry-run --limit 5
# AI remains off unless --use-ai is explicitly passed.
